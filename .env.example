# Example environment variables for ANPR Maroc
# Copy to .env and fill real values (do NOT commit .env)

# --- Caméra ---
# ANPR_RTSP_URL est la source utilisée par live_camera.py et
# test_rtsp_connection.py. Sans elle, les deux scripts s'arrêtent avec un
# message explicite : aucune URL n'est codée en dur dans le dépôt.
# Si le mot de passe contient '@' ou ':', les scripts réessaient
# automatiquement avec la forme percent-encodée (@ -> %40).
ANPR_RTSP_URL=rtsp://USER:PASS@192.168.1.100:554/Streaming/channels/101
CAMERA_RTSP_URL=rtsp://USER:PASS@192.168.1.100:554/stream
CAMERA_IP=192.168.1.100
RTSP_USER=your_user
RTSP_PASS=your_pass

SERVER_URL=https://anpr-server.example.com/api/detections
JWT_SECRET=replace_with_secure_random

# --- Reconnaissance de la lettre arabe ---
# Checkpoint CNN utilisé pour la zone lettre. Défaut depuis la phase 4 :
# models/arabic_letter_classifier_real2.pt — 4 classes (أ, ب, د + rejet),
# entraîné puis mesuré sur des crops de plaques réelles
# (docs/arabic_letter_model.md). Les anciens modèles restent chargeables mais
# ont été mesurés nettement moins bons sur le jeu de test scellé :
#   models/arabic_letter_classifier_finetuned.pt  3 classes, 8/22 (obsolète)
#   models/arabic_letter_classifier_ahcd.pt       28 classes, manuscrit
# ANPR_ARABIC_LETTER_MODEL=models/arabic_letter_classifier_real2.pt

# --- Stockage (voir config/schema_mysql.sql) ---
# ANPR_DB_BACKEND: mysql | sqlite | auto (auto = MySQL si joignable, sinon SQLite)
ANPR_DB_BACKEND=auto
ANPR_DB_HOST=127.0.0.1
ANPR_DB_PORT=3306
ANPR_DB_USER=anpr
ANPR_DB_PASSWORD=replace_with_db_password
ANPR_DB_NAME=anpr
ANPR_DB_SQLITE=plates.db

# --- API de consultation ---
ANPR_API_HOST=0.0.0.0
ANPR_API_PORT=8000
ANPR_CROPS_DIR=data/pipeline_output/live
